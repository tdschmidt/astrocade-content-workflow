{
  "name": "astrocade-content-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --import tsx src/core/cli.ts",
    "pipeline": "node --import tsx src/core/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "browser:install": "playwright install chromium --no-shell",
    "doctor": "node --import tsx src/server/doctor.ts"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
