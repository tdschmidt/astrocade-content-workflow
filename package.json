{
  "name": "astrocade-content-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --import tsx --watch src/server/index.ts",
    "start": "node --import tsx src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "browser:install": "playwright install chromium --no-shell",
    "doctor": "node --import tsx src/server/doctor.ts"
  },
  "dependencies": {
    "@google/genai": "2.27.0",
    "express": "5.2.1",
    "imapflow": "2.2.6",
    "mailparser": "3.9.36",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mailparser": "3.9.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
