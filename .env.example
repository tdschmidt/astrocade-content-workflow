# Or enter these in the local workbench's Setup screen. Never commit real keys.
GEMINI_API_KEY=
TAVILY_API_KEY=
# Required before exposing the workbench through ngrok. Username is studio.
WORKBENCH_PASSWORD=
PORT=4310
# macOS: brew install ffmpeg-full. The app detects its standard Homebrew path.
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
# Optional Instagram inputs. Use the actual owner's birthday, YYYY-MM-DD.
# INSTAGRAM_USERNAME=
# INSTAGRAM_DISPLAY_NAME=
# INSTAGRAM_BIRTHDAY=
# INSTAGRAM_PASSWORD=
# INSTAGRAM_EMAIL=
