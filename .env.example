# Optional for --provider gemini. The Codex provider uses codex login.
# Never commit real keys.
GEMINI_API_KEY=
# macOS: brew install ffmpeg-full. The pipeline detects its standard Homebrew path.
# FFMPEG_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
